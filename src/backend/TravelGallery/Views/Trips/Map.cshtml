@{
    ViewData["Title"] = "Mapa cest";
    var trips = ViewBag.Trips as System.Collections.IEnumerable;
    var tripsList = new List<object>();
    if (trips != null) foreach (var t in trips) tripsList.Add(t);
    var tripCount = tripsList.Count;
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        #world-map { height: calc(100vh - 200px); min-height: 500px; border-radius: 10px; }
        .leaflet-popup-content { margin: 8px 12px; }
        .map-popup { text-align: center; }
        .map-popup img { max-width: 140px; border-radius: 4px; display: block; margin: 0 auto 6px; }
        .map-popup .title { font-weight: 600; display: block; margin-bottom: 2px; }
        .map-popup .date { font-size: .78rem; color: #6c757d; display: block; margin-bottom: 6px; }
        .map-popup a { text-decoration: none; font-size: .85rem; }
    </style>
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">🗺 Mapa cest</h1>
    <span class="text-muted small">@tripCount výletů s GPS</span>
</div>

@if (tripCount == 0)
{
    <div class="alert alert-info">
        Žádný výlet nemá zadané souřadnice. Přidej GPS v editaci výletu, aby se zobrazil na mapě.
    </div>
}
else
{
    <div id="world-map"></div>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const trips = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            tripsList,
            new System.Text.Json.JsonSerializerOptions
            {
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default,
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }));

        if (trips.length > 0) {
            const map = L.map('world-map');
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            const bounds = [];
            trips.forEach(t => {
                const detailUrl = '/Trips/Detail/' + t.id;
                const dateStr = new Date(t.date).toLocaleDateString('cs-CZ');
                const thumbHtml = t.thumbUrl
                    ? `<img src="${t.thumbUrl}" alt="" loading="lazy" />`
                    : '';
                const popup = `<div class="map-popup">
                    ${thumbHtml}
                    <span class="title">${t.title}</span>
                    <span class="date">${dateStr} · 📸 ${t.mediaCount}</span>
                    <a href="${detailUrl}">Otevřít výlet →</a>
                </div>`;
                L.marker([t.lat, t.lng]).addTo(map).bindPopup(popup);
                bounds.push([t.lat, t.lng]);
            });

            if (bounds.length === 1) {
                map.setView(bounds[0], 10);
            } else {
                map.fitBounds(bounds, { padding: [40, 40], maxZoom: 12 });
            }
        }
    </script>
}
